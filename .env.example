# Lotinha Analytics — configurações de ambiente
# Copie para .env e ajuste os valores

# Caminho do banco SQLite (relativo à raiz do projeto)
LOTINHA_DB_PATH=data/lotinha.db

# Intervalo mínimo entre requests à API (segundos)
LOTINHA_API_RATE_LIMIT=1.5

# URL base da API
LOTINHA_API_BASE_URL=https://api.pontodobicho.com

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOTINHA_LOG_LEVEL=INFO

# Diretório de logs
LOTINHA_LOG_DIR=logs

# Diretório de cache de payloads brutos
LOTINHA_CACHE_DIR=data/cache

# Número máximo de backups do banco a manter
LOTINHA_MAX_BACKUPS=5

# Prêmios por faixa (separados por vírgula: 11,12,13,14,15 acertos)
# Preencher com os valores reais da banca
LOTINHA_PREMIOS_POR_FAIXA=0,0,0,0,0

# Custo das apostas por quantidade de números (17..23), separados por vírgula
LOTINHA_CUSTO_APOSTAS=0,0,0,0,0,0,0
